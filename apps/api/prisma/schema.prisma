generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  passwordHash         String                @default("")
  plan                 String                @default("FREE")
  onboardingCompleted  Boolean               @default(false)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  profile              Profile?
  resumes              Resume[]
  jobs                 Job[]
  applications         Application[]
  conversations        AIConversation[]
  coverLetters         CoverLetter[]
  contentStrategy      ContentStrategy?
  contentPillars       ContentPillar[]
  contentIdeas         ContentIdea[]
  contentDrafts        ContentDraft[]
  ownedAuditEvents     AuditEvent[]          @relation("AuditEventOwner")
  actorAuditEvents     AuditEvent[]          @relation("AuditEventActor")
  contentApprovals     ContentApproval[]     @relation("ContentApprovalOwner")
  approvalActions      ContentApproval[]     @relation("ContentApprovalActor")
  idempotencyRecords   IdempotencyRecord[]
  agentRuns            AgentRun[]
  agentArtifacts       AgentArtifact[]
  contentRevisions     ContentRevision[]
  sourceDocuments      SourceDocument[]
  memoryFacts          MemoryFact[]
  memorySources        MemorySource[]
  writingStyleProfile  WritingStyleProfile?
  writingStyleExamples WritingStyleExample[]
  memoryFactVersions   MemoryFactVersion[]
  researchRuns         ResearchRun[]
  usagePeriods         UsagePeriod[]
  usageReservations    UsageReservation[]
  researchSources      ResearchSource[]
}

model Profile {
  id                 String          @id @default(cuid())
  userId             String          @unique
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName          String?
  lastName           String?
  headline           String?
  summary            String?
  location           String?
  phone              String?
  website            String?
  yearsOfExperience  Int?
  targetRoles        String[]        @default([])
  preferredLocations String[]        @default([])
  remotePreference   String?
  experiences        Experience[]
  educations         Education[]
  skills             Skill[]
  projects           Project[]
  certifications     Certification[]
  achievements       Achievement[]
}

model Experience {
  id          String    @id @default(cuid())
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  company     String
  title       String
  startDate   DateTime
  endDate     DateTime?
  description String?

  @@index([profileId, startDate])
}

model Education {
  id          String    @id @default(cuid())
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  institution String
  degree      String
  field       String?
  startDate   DateTime
  endDate     DateTime?

  @@index([profileId, startDate])
}

model Skill {
  id         String  @id @default(cuid())
  profileId  String
  profile    Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name       String
  level      String?
  technology Boolean @default(false)

  @@index([profileId, name])
}

model Project {
  id          String  @id @default(cuid())
  profileId   String
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name        String
  description String?
  url         String?

  @@index([profileId])
}

model Certification {
  id        String    @id @default(cuid())
  profileId String
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String
  issuer    String?
  issuedAt  DateTime?

  @@index([profileId, issuedAt])
}

model Achievement {
  id          String  @id @default(cuid())
  profileId   String
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title       String
  description String?

  @@index([profileId])
}

model Resume {
  id            String               @id @default(cuid())
  userId        String
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  versions      ResumeVersion[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  optimizations ResumeOptimization[]

  @@index([userId, updatedAt])
}

model ResumeVersion {
  id           String        @id @default(cuid())
  resumeId     String
  resume       Resume        @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  version      Int
  content      Json
  createdAt    DateTime      @default(now())
  applications Application[]

  @@unique([resumeId, version])
  @@index([resumeId, createdAt])
}

model ResumeOptimization {
  id             String   @id @default(cuid())
  resumeId       String
  resume         Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  jobDescription String
  provider       String
  suggestions    Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([resumeId, updatedAt])
}

model Job {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  company        String
  title          String
  location       String?
  remoteStatus   String?
  url            String?
  description    String?
  skills         String[]      @default([])
  experience     String?
  salaryMin      Float?
  salaryMax      Float?
  salaryCurrency String?
  source         String?
  applicationUrl String?
  postedDate     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  savedJob       SavedJob?
  applications   Application[]

  @@index([userId, updatedAt])
  @@index([userId, title])
}

model SavedJob {
  id       String   @id @default(cuid())
  jobId    String   @unique
  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  savedAt  DateTime @default(now())
  notes    String?
  priority String   @default("medium")

  @@index([priority, savedAt])
}

model Application {
  id              String                     @id @default(cuid())
  userId          String
  user            User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId           String
  job             Job                        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status          String
  appliedAt       DateTime?
  resumeVersionId String?
  resumeVersion   ResumeVersion?             @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)
  notes           String?
  interviewDate   DateTime?
  followUpDate    DateTime?
  updatedAt       DateTime                   @updatedAt
  coverLetters    CoverLetter[]
  interviews      Interview[]
  followUps       FollowUp[]
  statusHistory   ApplicationStatusHistory[]

  @@index([userId, updatedAt])
  @@index([userId, status])
  @@index([userId, followUpDate])
  @@index([jobId])
}

model ApplicationStatusHistory {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    String?
  toStatus      String
  changedAt     DateTime    @default(now())

  @@index([applicationId, changedAt])
}

model CoverLetter {
  id             String       @id @default(cuid())
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId  String?
  application    Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  resumeId       String?
  company        String?
  role           String?
  jobDescription String?
  provider       String?
  content        String
  sourceFactIds  String[]     @default([])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([userId, updatedAt])
  @@index([applicationId, createdAt])
}

model Interview {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scheduledAt   DateTime?
  stage         String      @default("Technical Interview")
  notes         String?
  preparation   Json?
  answers       Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([applicationId, updatedAt])
}

model FollowUp {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  dueAt         DateTime
  completedAt   DateTime?
  note          String

  @@index([applicationId, dueAt])
}

model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  messages  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

model ContentStrategy {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetAudience   String   @default("")
  writingVoice     String   @default("")
  postingFrequency String   @default("")
  recurringThemes  String[] @default([])
  updatedAt        DateTime @updatedAt
}

model ContentPillar {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  ideas       ContentIdea[]

  @@index([userId, updatedAt])
}

model ContentIdea {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  pillarId  String?
  pillar    ContentPillar? @relation(fields: [pillarId], references: [id], onDelete: SetNull)
  title     String
  prompt    String
  status    String         @default("BACKLOG")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  drafts    ContentDraft[]

  @@index([userId, status, updatedAt])
  @@index([pillarId])
}

model ContentDraft {
  id             String             @id @default(cuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceIdeaId   String?
  sourceIdea     ContentIdea?       @relation(fields: [sourceIdeaId], references: [id], onDelete: SetNull)
  title          String
  topic          String
  body           String
  status         ContentDraftStatus @default(DRAFT)
  sourceFactIds  String[]           @default([])
  failureReason  String?
  reviewedAt     DateTime?
  approvedAt     DateTime?
  scheduledAt    DateTime?
  publishedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  revisions      ContentRevision[]
  critiques      ContentCritique[]
  approvals      ContentApproval[]
  agentArtifacts AgentArtifact[]

  @@unique([id, userId])
  @@index([userId, status, updatedAt])
  @@index([userId, scheduledAt])
  @@index([sourceIdeaId])
}

model ContentRevision {
  id             String            @id @default(cuid())
  draftId        String
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  draft          ContentDraft      @relation(fields: [draftId, userId], references: [id, userId], onDelete: Cascade)
  version        Int
  body           String
  changeType     String
  createdAt      DateTime          @default(now())
  approvals      ContentApproval[]
  agentArtifacts AgentArtifact[]

  @@unique([draftId, version])
  @@unique([id, userId])
  @@index([draftId, createdAt])
}

enum ContentDraftStatus {
  DRAFT
  REVIEW
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  PUBLISH_FAILED
  ARCHIVED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  REQUEST_CHANGES
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum AgentFailureCategory {
  CONFIGURATION
  AUTHENTICATION
  RATE_LIMIT
  TIMEOUT
  PROVIDER_UNAVAILABLE
  INVALID_REQUEST
  INVALID_OUTPUT
  SAFETY_POLICY
  CANCELLED
  UNKNOWN
}

model AgentRun {
  id                   String                @id @default(cuid())
  userId               String
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  operation            String
  status               AgentRunStatus        @default(QUEUED)
  provider             String
  model                String
  promptIdentifier     String
  promptVersion        Int
  correlationId        String?
  idempotencyKey       String?
  schemaName           String
  schemaVersion        Int
  inputTokenCount      Int?
  outputTokenCount     Int?
  totalTokenCount      Int?
  estimatedCost        Float?
  costCurrency         String?
  failureCategory      AgentFailureCategory?
  failureMessage       String?
  queuedAt             DateTime              @default(now())
  startedAt            DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?
  heartbeatAt          DateTime?
  leaseExpiresAt       DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  artifacts            AgentArtifact[]
  usages               ModelUsage[]
  writingStyleProfiles WritingStyleProfile[]

  @@unique([id, userId])
  @@index([userId, status, createdAt])
  @@index([userId, operation, createdAt])
  @@index([userId, idempotencyKey])
}

model AgentArtifact {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  runId        String
  run          AgentRun         @relation(fields: [runId, userId], references: [id, userId], onDelete: Cascade)
  artifactType String
  payload      Json?
  draftId      String?
  draft        ContentDraft?    @relation(fields: [draftId, userId], references: [id, userId], onDelete: Restrict)
  revisionId   String?
  revision     ContentRevision? @relation(fields: [revisionId, userId], references: [id, userId], onDelete: Restrict)
  createdAt    DateTime         @default(now())

  @@index([userId, artifactType, createdAt])
  @@index([runId, createdAt])
  @@index([draftId])
  @@index([revisionId])
}

model PromptVersion {
  id             String   @id @default(cuid())
  identifier     String
  version        Int
  schemaName     String
  schemaVersion  Int
  templateDigest String
  description    String?
  createdAt      DateTime @default(now())

  @@unique([identifier, version])
  @@index([identifier, createdAt])
}

model ModelUsage {
  id            String   @id @default(cuid())
  runId         String
  run           AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  provider      String
  model         String
  inputTokens   Int?
  outputTokens  Int?
  totalTokens   Int?
  estimatedCost Float?
  costCurrency  String?
  createdAt     DateTime @default(now())

  @@index([runId, createdAt])
  @@index([provider, model, createdAt])
}

enum MemoryFactType {
  SUMMARY
  EXPERIENCE
  EDUCATION
  SKILL
  PROJECT
  CERTIFICATION
  ACHIEVEMENT
  PREFERENCE
  OTHER
}

enum MemoryReviewState {
  CANDIDATE
  VERIFIED
  REJECTED
  SUPERSEDED
}

enum MemorySourceType {
  PROFILE
  RESUME
  PROJECT
  USER_ENTERED
  IMPORTED_DOCUMENT
  AI_EXTRACTED_CANDIDATE
}

enum StyleExampleSourceType {
  USER_ENTERED
  CONTENT_DRAFT
  IMPORTED_DOCUMENT
}

model SourceDocument {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceType    MemorySourceType
  sourceRef     String?
  title         String
  contentHash   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  memorySources MemorySource[]

  @@unique([id, userId])
  @@index([userId, sourceType, updatedAt])
  @@index([userId, sourceRef])
}

model MemoryFact {
  id              String              @id @default(cuid())
  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  factType        MemoryFactType
  category        String
  normalizedValue String
  canonicalKey    String?
  confidence      Float?
  reviewState     MemoryReviewState   @default(CANDIDATE)
  version         Int                 @default(1)
  verifiedAt      DateTime?
  rejectedAt      DateTime?
  supersededAt    DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  sources         MemorySource[]
  versions        MemoryFactVersion[]

  @@unique([id, userId])
  @@index([userId, reviewState, updatedAt])
  @@index([userId, factType, reviewState])
  @@index([userId, canonicalKey])
}

model MemoryFactVersion {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  factId          String
  fact            MemoryFact        @relation(fields: [factId, userId], references: [id, userId], onDelete: Cascade)
  version         Int
  factType        MemoryFactType
  category        String
  normalizedValue String
  confidence      Float?
  reviewState     MemoryReviewState
  changeReason    String?
  changedByUserId String?
  createdAt       DateTime          @default(now())

  @@unique([factId, version])
  @@index([userId, factId, createdAt])
}

model MemorySource {
  id                   String           @id @default(cuid())
  userId               String
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  factId               String
  fact                 MemoryFact       @relation(fields: [factId, userId], references: [id, userId], onDelete: Cascade)
  sourceType           MemorySourceType
  sourceRef            String?
  sourceDocumentId     String?
  sourceDocumentUserId String?
  sourceDocument       SourceDocument?  @relation(fields: [sourceDocumentId, sourceDocumentUserId], references: [id, userId], onDelete: SetNull)
  sourceLabel          String?
  metadata             Json?
  createdAt            DateTime         @default(now())

  @@index([userId, factId, createdAt])
  @@index([userId, sourceType, sourceRef])
  @@index([sourceDocumentId])
}

model WritingStyleProfile {
  id                     String            @id @default(cuid())
  userId                 String            @unique
  user                   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tone                   String?
  sentenceStyle          String?
  technicalDepth         String?
  storytellingPreference String?
  hookStyle              String?
  formattingPreference   String?
  emojiUsage             String?
  ctaPreference          String?
  opinionStrength        String?
  firstPersonUsage       String?
  typicalLength          String?
  explicitPreferences    Json?
  reviewState            MemoryReviewState @default(CANDIDATE)
  analysisRunId          String?
  analysisRunUserId      String?
  analysisRun            AgentRun?         @relation(fields: [analysisRunId, analysisRunUserId], references: [id, userId], onDelete: SetNull)
  analyzedExampleIds     Json?
  analyzedAt             DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@index([reviewState, updatedAt])
  @@index([analysisRunId])
}

model WritingStyleExample {
  id                 String                 @id @default(cuid())
  userId             String
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  content            String
  sourceType         StyleExampleSourceType
  sourceRef          String?
  includedInAnalysis Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([userId, includedInAnalysis, updatedAt])
  @@index([userId, sourceType, sourceRef])
}

model AuditEvent {
  id            String   @id @default(cuid())
  ownerUserId   String
  ownerUser     User     @relation("AuditEventOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  actorUserId   String
  actorUser     User     @relation("AuditEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  resourceType  String
  resourceId    String
  action        String
  result        String
  reason        String?
  metadata      Json?
  correlationId String?
  occurredAt    DateTime @default(now())

  @@index([ownerUserId, occurredAt])
  @@index([ownerUserId, resourceType, resourceId, occurredAt])
  @@index([actorUserId, occurredAt])
}

model ContentApproval {
  id          String           @id @default(cuid())
  ownerUserId String
  ownerUser   User             @relation("ContentApprovalOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  actorUserId String
  actorUser   User             @relation("ContentApprovalActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  draftId     String
  draft       ContentDraft     @relation(fields: [draftId], references: [id], onDelete: Restrict)
  revisionId  String
  revision    ContentRevision  @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  decision    ApprovalDecision
  reason      String?
  createdAt   DateTime         @default(now())

  @@index([ownerUserId, createdAt])
  @@index([draftId, createdAt])
  @@index([revisionId])
}

model IdempotencyRecord {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  key            String
  operation      String
  requestHash    String
  status         IdempotencyStatus @default(IN_PROGRESS)
  responseStatus Int?
  responseBody   Json?
  resourceId     String?
  errorCode      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  expiresAt      DateTime?

  @@unique([userId, key, operation])
  @@index([userId, createdAt])
  @@index([expiresAt])
}

model ContentCritique {
  id        String       @id @default(cuid())
  draftId   String
  draft     ContentDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  provider  String
  result    Json
  createdAt DateTime     @default(now())

  @@index([draftId, createdAt])
}

enum ResearchRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  UNAVAILABLE
}

enum ResearchSourceSafety {
  UNCLASSIFIED
  SAFE_DATA
  PROMPT_INJECTION_SUSPECTED
  BLOCKED
}

model ResearchRun {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  query         String
  status        ResearchRunStatus @default(QUEUED)
  provider      String
  failureReason String?
  createdAt     DateTime          @default(now())
  completedAt   DateTime?
  updatedAt     DateTime          @updatedAt
  sources       ResearchSource[]

  @@unique([id, userId])
  @@index([userId, status, createdAt])
}

model ResearchSource {
  id             String               @id @default(cuid())
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  runId          String
  run            ResearchRun          @relation(fields: [runId, userId], references: [id, userId], onDelete: Cascade)
  url            String
  title          String?
  contentHash    String
  content        String?
  fetchedAt      DateTime?
  freshnessUntil DateTime?
  safety         ResearchSourceSafety @default(UNCLASSIFIED)
  citations      ResearchCitation[]
  createdAt      DateTime             @default(now())

  @@unique([id, userId])
  @@unique([runId, url])
  @@index([userId, createdAt])
  @@index([userId, contentHash])
}

model ResearchCitation {
  id        String         @id @default(cuid())
  userId    String
  sourceId  String
  source    ResearchSource @relation(fields: [sourceId, userId], references: [id, userId], onDelete: Cascade)
  claim     String
  quote     String?
  locator   String?
  createdAt DateTime       @default(now())

  @@index([userId, sourceId])
}

enum UsagePeriodStatus {
  OPEN
  CLOSED
}

model UsagePeriod {
  id            String             @id @default(cuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodStart   DateTime
  periodEnd     DateTime
  postLimit     Int?
  reservedPosts Int                @default(0)
  consumedPosts Int                @default(0)
  status        UsagePeriodStatus  @default(OPEN)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  reservations  UsageReservation[]

  @@unique([id, userId])
  @@unique([userId, periodStart, periodEnd])
  @@index([userId, status, periodEnd])
}

enum UsageReservationStatus {
  RESERVED
  CONSUMED
  RELEASED
  EXPIRED
}

model UsageReservation {
  id             String                 @id @default(cuid())
  userId         String
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodId       String
  period         UsagePeriod            @relation(fields: [periodId, userId], references: [id, userId], onDelete: Cascade)
  operation      String
  idempotencyKey String
  quantity       Int                    @default(1)
  status         UsageReservationStatus @default(RESERVED)
  createdAt      DateTime               @default(now())
  consumedAt     DateTime?
  releasedAt     DateTime?

  @@unique([userId, operation, idempotencyKey])
  @@index([userId, status, createdAt])
}
