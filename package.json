{
  "name": "personal-brand-assistant",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=22.15.0 <23"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace @pba/api\" \"npm run dev --workspace @pba/web\"",
    "build": "npm run build --workspace @pba/shared && npm run build --workspace @pba/api && npm run build --workspace @pba/web",
    "typecheck": "npm run build --workspace @pba/shared && npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run build --workspace @pba/shared && npm run test --workspaces --if-present",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "db:generate": "npm run prisma:generate --workspace @pba/api",
    "db:migrate": "npm run prisma:migrate --workspace @pba/api",
    "db:seed": "npm run db:seed --workspace @pba/api",
    "db:setup": "npm run db:setup --workspace @pba/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.15.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.26.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0"
  }
}
